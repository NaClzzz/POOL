{
  "name": "pool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "auth:generate": "node --conditions=react-server --env-file=.env node_modules/auth/dist/index.mjs generate --config src/server/auth/core.ts --output src/server/db/schema.ts --yes",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "infra:up": "docker compose up -d --wait",
    "infra:stop": "docker compose stop",
    "test:integration": "node --conditions=react-server --env-file=.env --import tsx --test tests/integration/auth.integration.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/react": "^0.5.3",
    "@hookform/resolvers": "7.0.3",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-virtual": "3.14.26",
    "better-auth": "1.7.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "redis": "6.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.18",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.5",
    "prettier": "3.6.2",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
