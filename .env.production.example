# 只用于 compose.production.yaml
POSTGRES_USER=pool
POSTGRES_PASSWORD=replace_with_random_database_password
POSTGRES_DB=pool
DATABASE_URL=postgresql://pool:replace_with_random_database_password@postgres:5432/pool
REDIS_PASSWORD=replace_with_random_redis_password
REDIS_URL=redis://:replace_with_random_redis_password@redis:6379

# 真实公网地址
BETTER_AUTH_URL=https://pool.example.com
BETTER_AUTH_SECRET=replace_with_random_auth_secret_at_least_32_characters

# 唯一浏览器构建参数：留空使用公网同域 /socket.io/，变更后需要重建 Web
NEXT_PUBLIC_SOCKET_URL=
# 宿主机回环端口；如调整，需同步 deploy/nginx/pool.conf。
WEB_PORT=3000
SOCKET_PORT=3002
POOL_IMAGE_TAG=local

# 仅 Web 运行时读取；空密钥时 AI 返回未配置，其余业务可运行
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://ws-hmgfth5uyiijbxu5.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4.1-flash-1017

# 可选镜像来源覆盖；数据库与 Redis 保持生产 Compose 中的摘要
# NODE_IMAGE=node:24.13.0-slim
# MUSIC_NODE_IMAGE=node:lts-alpine
# POSTGRES_IMAGE=
# REDIS_IMAGE=
