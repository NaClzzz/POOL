# PostgreSQL
POSTGRES_USER=pool
POSTGRES_PASSWORD=replace_with_a_local_database_password
POSTGRES_DB=pool
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pool:replace_with_a_local_database_password@127.0.0.1:5432/pool

# Redis
REDIS_PASSWORD=replace_with_a_local_redis_password
REDIS_PORT=6379
REDIS_URL=redis://:replace_with_a_local_redis_password@127.0.0.1:6379

#Better Auth
BETTER_AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters
BETTER_AUTH_URL=http://localhost:3000

# 默认忽略客户端提供的代理 IP；部署在可信反向代理后方时才配置此值
AUTH_TRUST_PROXY=false

# 可选：网络受限时覆盖镜像地址，保持 compose.yaml 中固定的摘要
#POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:18@sha256:e3d24f6906d0760bf4da0dae872415391ededefad23fd471c47dc53b0ddf3c42
#REDIS_IMAGE=docker.m.daocloud.io/library/redis:8-alpine@sha256:71885d8cc6e42f2bc0aa2eb853bfc4be200b5108a46ac50e117ae1df0531fb80

# 网易云 api 服务
MUSIC_API_BASE_URL=http://127.0.0.1:3001
NETEASE_SOURCE_DIR=

# 独立 socket.io 进程
SOCKET_HOST=127.0.0.1
SOCKET_PORT=3002
ROOM_WEB_URL=http://localhost:3000
# 使用至少 32 字符随机密钥，Web 和 Socket 读取同一值
ROOM_INTERNAL_SECRET=replace_with_a_separate_random_secret_at_least_32_characters
# 部署时将 NEXT_PUBLIC_SOCKET_URL 留空，使用同域 /socket.io/ 反向代理
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002

# AI api 
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://ws-hmgfth5uyiijbxu5.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4.1-flash-1017
